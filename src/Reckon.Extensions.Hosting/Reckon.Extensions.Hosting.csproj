<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Reckon.Extensions.Hosting</PackageId>
    <RootNamespace>Reckon.Extensions.Hosting</RootNamespace>
    <AssemblyName>Reckon.Extensions.Hosting</AssemblyName>
    <Description>Dependency-injection and hosting glue for the ReckonDB .NET client: AddReckonClient, a subscription-driven BackgroundService for projections, and a gateway health check.</Description>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reckon.Client\Reckon.Client.csproj" />
  </ItemGroup>

</Project>
